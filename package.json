{
  "name": "@nanoexpress/route-syntax-parser",
  "description": "Syntax parser for each router to power performance of nanoexpress",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "typings": "typings/src/analyze.d.ts",
  "main": "esm/analyze.js",
  "license": "GPL-3.0",
  "scripts": {
    "lint": "biome check . && rumdl check .",
    "format": "biome check --write . && rumdl fmt .",
    "prepare": "lefthook install",
    "build": "bun build ./src/analyze.ts --outdir esm --target node --sourcemap=linked && tsc --emitDeclarationOnly",
    "test": "bun run build && node --test tests/"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "commitlint-config-airlight": "^6.0.5",
    "lefthook": "^2.1.15",
    "rumdl": "^0.2.78",
    "typescript": "^7.0.2"
  }
}
